<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    xml:lang="en">
  <head>
    <metadata>
      <ttm:agent xml:id="v1" type="person"/>
      <ttm:agent xml:id="v2" type="person"/>
    </metadata>
  </head>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.000" ttm:agent="v1">
        <span begin="1.000s" end="1.400s">Hel</span><span begin="1.400s" end="1.800s">lo</span>
        <span ttm:role="x-translation">Halo</span>
        <span ttm:role="x-roman">Herro</span>
      </p>
      <p begin="00:00:03.200" end="00:00:05.000" ttm:agent="v2">
        <span begin="3.200s" end="3.600s">Second</span> <span begin="3.700s" end="4.200s">voice</span>
      </p>
      <p begin="00:05.200" end="00:07.000" ttm:agent="v1">
        <span begin="5.200s" end="5.600s">Main</span>
        <span ttm:role="x-bg" begin="5.600s" end="7.000s">background</span>
      </p>
      <p begin="7.200s" end="9.000s">
        <span ttm:role="x-bg" begin="7.200s" end="9.000s">Echo</span>
      </p>
    </div>
  </body>
</tt>
