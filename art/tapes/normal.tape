Output "../modes/raw/normal.gif"

Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono, Noto Sans CJK JP, Noto Sans CJK KR, Noto Sans CJK SC, DejaVu Sans Mono, monospace"
Set FontSize 16
Set Width 1300
Set Height 860
Set Padding 2
Set Theme { "name": "lyrachi-banner", "background": "#161718", "foreground": "#FAFAFA", "cursor": "#FA2560", "black": "#2c2d30", "red": "#FA2560", "green": "#8fb573", "yellow": "#e0af68", "blue": "#CBA6F7", "magenta": "#EE4580", "cyan": "#f78fb0", "white": "#c8c9cd", "brightBlack": "#6b6f76", "brightRed": "#FA2560", "brightGreen": "#a5c99a", "brightYellow": "#ecc48a", "brightBlue": "#d9b8fb", "brightMagenta": "#f78fb0", "brightCyan": "#fbb1c9", "brightWhite": "#FAFAFA" }

Hide
Type "./restart-playback.sh"
Enter
Sleep 600ms
Type "clear"
Enter
Sleep 300ms
Show

Type "lyrachi"
Sleep 600ms
Enter
Sleep 17s
Type "q"
Sleep 500ms
