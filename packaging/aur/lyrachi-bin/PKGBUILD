# Maintainer: Ikhsan Satriadi <ikhsan3adi@proton.me>
pkgname=lyrachi-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Synchronized lyrics with animated visual stages in your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/ikhsan3adi/lyrachi"
license=('GPL3')
depends=('gcc-libs')
optdepends=('mpd: MPD media backend')
provides=('lyrachi')
conflicts=('lyrachi')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/lyrachi-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/lyrachi-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
# TODO(aur): the release assets are only reachable by the owner while the
# repository is private; fill both hashes from the matching `.sha256` assets
# after the v$pkgver release becomes public.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

# The release assets are prebuilt glibc binaries; no build step applies and
# check() is skipped for the same reason as the source package.

package() {
  cd "$srcdir"
  install -Dm0755 -t "$pkgdir/usr/bin/" lyrachi
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
